{
  "layout": {
    "allow": [
      ".agents",
      ".ast-grep",
      ".claude",
      ".gemini",
      ".github",
      "clients",
      "docs",
      "migrations",
      "openapi",
      "scripts",
      "src",
      "tests"
    ],
    "forbid": [
      "CLAUDE.md",
      "**/CLAUDE.md",
      "CLAUDE.local.md",
      "GEMINI.md",
      "**/GEMINI.md",
      ".cursorrules",
      ".github/copilot-instructions.md"
    ]
  },
  "docs": {
    "exclude": [
      "docs/plans/**",
      "docs/specs/**",
      "docs/archive/**",
      ".agents/**"
    ],
    "externalPrefixes": [
      "workflow/",
      "shared/"
    ],
    "ignorePaths": [
      "target",
      "target/**"
    ],
    "envExample": ".env.example",
    "envDocumentedIn": "README.md"
  },
  "dependencies": {
    "ledger": "docs/dependencies.md",
    "manifests": [
      "Cargo.toml"
    ]
  },
  "versions": [
    {
      "name": "postgres",
      "sources": [
        {
          "file": "compose.yaml",
          "pattern": "image:\\s*postgres:(\\S+)"
        }
      ]
    },
    {
      "name": "cargo-deny",
      "sources": [
        {
          "file": "Makefile",
          "pattern": "^CARGO_DENY_VERSION\\s*:=\\s*(\\S+)"
        }
      ]
    },
    {
      "name": "cargo-machete",
      "sources": [
        {
          "file": "Makefile",
          "pattern": "^CARGO_MACHETE_VERSION\\s*:=\\s*(\\S+)"
        }
      ]
    },
    {
      "name": "github-pin",
      "sources": [
        {
          "file": ".github/workflows/ci.yml",
          "pattern": "\\.github/\\.github/workflows/\\w+\\.yml@(\\S+)"
        },
        {
          "file": ".github/workflows/codeql.yml",
          "pattern": "\\.github/\\.github/workflows/\\w+\\.yml@(\\S+)"
        },
        {
          "file": ".github/workflows/dast.yml",
          "pattern": "\\.github/\\.github/workflows/\\w+\\.yml@(\\S+)"
        }
      ]
    }
  ]
}
