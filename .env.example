HOST=0.0.0.0
PORT=8000
APP_NAME=template-rust
APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:password@localhost:5432/template_rust
# TEMPLATE-TODO(auth): replace header identity with real authentication, then remove this flag
TRUST_IDENTITY_HEADER=true
# TEMPLATE-TODO(auth): point these at the product's JWKS endpoint (Better Auth jwt plugin).
# When PRODUCT_JWKS_URL is set, `Authorization: Bearer` tokens are validated and `sub` becomes the caller.
PRODUCT_JWKS_URL=
PRODUCT_JWT_ISSUER=
PRODUCT_JWT_AUDIENCE=
# Comma-separated browser origins allowed by CORS. Empty disables CORS.
CORS_ALLOWED_ORIGINS=
# Host port Postgres publishes in compose.yaml. Change it if 5432 is taken.
POSTGRES_PORT=5432
